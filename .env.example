# ==========================================
# JARVIS CONFIGURATION
# ==========================================
# Get your free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# AI Brain Settings
GEMINI_MODEL=gemini-2.0-flash

# Voice / TTS Settings (Microsoft Edge Neural Voices)
# Options:
# "en-GB-RyanNeural" (British Male - Authentic Jarvis)
# "en-GB-SoniaNeural" (British Female - Friday)
# "en-US-ChristopherNeural" (US Male)
# "en-US-GuyNeural" (US Male)
JARVIS_VOICE=en-GB-RyanNeural
JARVIS_SPEECH_RATE=+5%
JARVIS_PITCH=+0Hz

# User & Assistant Personalization
ASSISTANT_NAME=JARVIS
USER_NAME=Sir
